# Copy this file to .env and adjust values, or export these as real environment variables.

# Path to the service configuration file (see config.example.json)
CONFIG_PATH=./config.json

# HTTP port the proxy listens on (overrides config.json "port")
PORT=8080

# Comma-separated list of allowed browser origins, wildcards ("*") supported per segment.
# Overrides config.json "allowedOrigins" when set.
ALLOWED_ORIGINS=https://*.kommonitor.de,http://localhost:*

# Optional comma-separated allowlist of upstream hostnames (wildcards allowed, e.g. "*.example.com").
# Overrides config.json "allowedUpstreamHosts" when set. Leave unset to only enforce the
# built-in denylist of private/loopback/link-local/metadata addresses.
# ALLOWED_UPSTREAM_HOSTS=

# Default upstream request timeout in milliseconds (overrides config.json "requestTimeoutMs")
REQUEST_TIMEOUT_MS=5000

# Whether to serve a transparent 1x1 PNG when an upstream call fails (overrides config.json "fallbackOnError")
FALLBACK_ON_ERROR=true

# Log level (fatal, error, warn, info, debug, trace, silent). Overrides config.json "logLevel".
# "debug" prints the upstream URL of every tile request (API key masked).
LOG_LEVEL=info

# Print API keys unmasked in debug logs. Only enable temporarily while troubleshooting.
# LOG_REVEAL_API_KEYS=false
