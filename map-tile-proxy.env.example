# Copy to map-tile-proxy.env and adjust for your deployment.
# Referenced by docker-compose.yml via env_file.

PORT=8080
ALLOWED_ORIGINS=https://*.kommonitor.de,http://localhost:*
REQUEST_TIMEOUT_MS=5000
FALLBACK_ON_ERROR=true
# Log level is set via LOG_LEVEL in the shell / docker-compose.yml or "logLevel" in config.json,
# not in this file (see docker-compose.yml).
# ALLOWED_UPSTREAM_HOSTS=*.example-provider.com,api.example-satellite.com
